# Aagam production API environment template
# Copy values into GitHub/VPS secrets. Do not commit real secrets.

NODE_ENV=production
PORT=3005

# Database and cache
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
REDIS_URL=redis://USER:PASSWORD@HOST:PORT

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters

# Browser clients allowed to call the API. Comma-separated.
CORS_ORIGINS=https://your-admin-domain.example.com,https://your-customer-domain.example.com
NEXT_PUBLIC_API_URL=https://your-api-domain.example.com

# Partner email verification
PARTNER_EMAIL_PROVIDER=MAILJET
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
PARTNER_VERIFICATION_FROM_EMAIL=your-validated-sender@example.com
PARTNER_VERIFICATION_FROM_NAME=Aagaam Verification

# Keep Resend available for later. Set PARTNER_EMAIL_PROVIDER=RESEND after an owned
# domain is verified, then configure this key and use a domain sender address.
RESEND_API_KEY=

# Phone verification mode:
# SMS_ONLY = use the selected OTP provider directly (recommended for WhatsApp).
# PNV_FIRST = try Firebase PNV first and fall back to the selected OTP provider.
# EMAIL_ONLY = disable phone verification.
PARTNER_PHONE_VERIFICATION_MODE=SMS_ONLY

# Phone OTP provider: WHATSAPP or TWILIO.
PARTNER_SMS_PROVIDER=WHATSAPP

# WhatsApp Business Platform / Cloud API
# Use a permanent System User token in production, not Meta's temporary test token.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Set this to the Graph API version enabled for your Meta app, for example vXX.X.
WHATSAPP_GRAPH_API_VERSION=
# Create and approve an AUTHENTICATION template with an OTP COPY_CODE button.
WHATSAPP_OTP_TEMPLATE_NAME=authentication_code_copy_code_button
WHATSAPP_OTP_TEMPLATE_LANGUAGE_CODE=en_US
# Generate the verify token yourself; copy exactly the same value into Meta Webhooks.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App Dashboard -> App settings -> Basic -> App secret.
WHATSAPP_APP_SECRET=
# Production callback URL for this deployment:
# https://aagam.accesscam.org/api/whatsapp/webhook

# Twilio SMS alternative. Required only when PARTNER_SMS_PROVIDER=TWILIO.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Firebase values used by Partner verification / push modules.
# FIREBASE_PROJECT_NUMBER is only required for phone verification when using PNV_FIRST.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PROJECT_NUMBER=

# Required for Store/Rider notifications while the Partners app is backgrounded or closed.
# Keep the complete Firebase Admin SDK JSON on one shell-quoted line when embedding it here.
# Preferred GitHub setup: store the raw JSON in the production environment secret named
# FIREBASE_SERVICE_ACCOUNT_JSON; deploy.yml overlays it onto this file safely.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-firebase-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk@example.iam.gserviceaccount.com"}'

# PLAYWRIGHT_QA and PARTNER_QA_VERIFICATION_CODE are test-only and must not be set in production.

# Optional third-party providers used by enabled modules
SUPABASE_URL=
SUPABASE_ANON_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
