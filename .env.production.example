# Aagam production API environment template
# Copy values into Railway/VPS secrets. Do not commit real secrets.

NODE_ENV=production
PORT=3005

# Database and cache
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
REDIS_URL=redis://USER:PASSWORD@HOST:PORT

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters

# Browser clients allowed to call the API. Comma-separated.
CORS_ORIGINS=https://your-admin-domain.example.com,https://your-customer-domain.example.com
NEXT_PUBLIC_API_URL=https://your-api-domain.example.com

# Partner verification delivery and Firebase PNV
RESEND_API_KEY=
PARTNER_VERIFICATION_FROM_EMAIL=AAGAM Verification <verify@your-domain.example>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_NUMBER=
PARTNER_PHONE_VERIFICATION_MODE=PNV_FIRST
PARTNER_SMS_PROVIDER=TWILIO

# PLAYWRIGHT_QA and PARTNER_QA_VERIFICATION_CODE are test-only and must not be set in production.

# Optional third-party providers used by enabled modules
SUPABASE_URL=
SUPABASE_ANON_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
