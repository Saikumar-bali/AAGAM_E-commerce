# Aagam production API environment template
# Copy values into Railway/VPS secrets. Do not commit real secrets.

NODE_ENV=production
PORT=3005

# Database and cache
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
REDIS_URL=redis://USER:PASSWORD@HOST:PORT

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters

# Public URL of the API (used by admin dashboard to make API calls)
# This MUST match your actual API domain
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Browser clients allowed to call the API. Comma-separated.
CORS_ORIGINS=https://your-admin-domain.example.com,https://your-customer-domain.example.com

# Optional third-party providers used by enabled modules
SUPABASE_URL=
SUPABASE_ANON_KEY=
FIREBASE_PROJECT_ID=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
