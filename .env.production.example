# Aagam production API environment template
# Copy values into Railway/VPS secrets. Do not commit real secrets.

NODE_ENV=production
PORT=3005

# Database and cache
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
REDIS_URL=redis://USER:PASSWORD@HOST:PORT

# Auth
JWT_SECRET=replace-with-at-least-32-random-characters

# Browser clients allowed to call the API. Comma-separated.
CORS_ORIGINS=https://your-admin-domain.example.com,https://your-customer-domain.example.com
NEXT_PUBLIC_API_URL=https://your-api-domain.example.com

# Partner email verification
# Temporary provider while AAGAM does not own a production sending domain.
PARTNER_EMAIL_PROVIDER=MAILJET
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
PARTNER_VERIFICATION_FROM_EMAIL=your-validated-sender@example.com
PARTNER_VERIFICATION_FROM_NAME=AAGAM Verification

# Keep Resend available for later. Set PARTNER_EMAIL_PROVIDER=RESEND after an owned
# domain is verified, then configure this key and use a domain sender address.
RESEND_API_KEY=

# Temporarily keep onboarding email-only because Firebase PNV carrier support is not
# available for Indian operators. Change to PNV_FIRST when a supported phone path exists.
PARTNER_PHONE_VERIFICATION_MODE=EMAIL_ONLY

# Required only when PARTNER_PHONE_VERIFICATION_MODE=PNV_FIRST.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=
FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_NUMBER=
PARTNER_SMS_PROVIDER=TWILIO

# PLAYWRIGHT_QA and PARTNER_QA_VERIFICATION_CODE are test-only and must not be set in production.

# Optional third-party providers used by enabled modules
SUPABASE_URL=
SUPABASE_ANON_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
