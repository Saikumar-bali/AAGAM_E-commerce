{
  "name": "aagam-ecommerse",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=!AagamMobile --filter=!AagamCustomer --filter=!AagamPartners",
    "build": "npm run build:api",
    "build:all": "turbo build",
    "start": "npm run railway:start:api",
    "build:api": "npm run build --workspace @aagam/types && npm run build --workspace @aagam/utils && npm run build --workspace @aagam/database && npm run build --workspace @aagam/api-gateway",
    "build:admin": "npm run build --workspace @aagam/types && npm run build --workspace @aagam/utils && npm run build --workspace @aagam/ui && npm run build --workspace @aagam/admin-dashboard",
    "start:api": "npm run start:prod --workspace @aagam/api-gateway",
    "start:admin": "npm run start:railway --workspace @aagam/admin-dashboard",
    "railway:start:api": "npm run check:env:prod && npm run db:migrate:prod && npm run start:api",
    "check:env:prod": "node scripts/validate-prod-env.js && bash scripts/ensure-pm2-node22-runtime.sh",
    "predeploy:audit": "node scripts/predeploy-readiness-audit.js",
    "predeploy:audit:live": "node scripts/predeploy-readiness-audit.js --live",
    "db:push:prod": "prisma db push --schema packages/database/prisma/schema.prisma",
    "db:migrate:prod": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "ci:api": "npx prisma validate --schema packages/database/prisma/schema.prisma && npm run test:ci --workspace=apps/api-gateway",
    "test": "npm run ci:api",
    "test:api": "npm run test --workspace=apps/api-gateway",
    "test:api-smoke": "npm run test:api-smoke --workspace=apps/api-gateway",
    "test:phase6": "npm run test:phase6 --workspace=apps/api-gateway",
    "test:phase8": "npm run test:phase8 --workspace=apps/api-gateway",
    "test:phase9": "npm run test:phase9 --workspace=apps/api-gateway",
    "test:phase10": "npm run test:phase10 --workspace=apps/api-gateway",
    "test:phase11": "npm run test:phase11 --workspace=apps/api-gateway",
    "test:phase12": "npm run test:phase12 --workspace=apps/api-gateway",
    "test:eta:sim": "node tests/simulate_eta_lifecycle.js",
    "test:maestro:customer": "cd tests/maestro && maestro test customer/",
    "test:maestro:partners": "cd tests/maestro && maestro test partners/",
    "test:maestro": "cd tests/maestro && maestro test",
    "test:perf:k6:api": "k6 run tests/performance/k6/load-test-api.js",
    "test:perf:k6:checkout": "k6 run tests/performance/k6/inventory-checkout-load.js",
    "test:perf:k6:rider-ws": "k6 run tests/performance/k6/rider-location-throughput.js",
    "test:perf:k6:campaigns": "k6 run tests/performance/k6/campaign-public-api-load.js",
    "test:perf:artillery:api": "artillery run tests/performance/artillery/api-load.yml",
    "test:perf:artillery:checkout": "artillery run tests/performance/artillery/checkout-load.yml",
    "test:perf:artillery:campaigns": "artillery run tests/performance/artillery/campaign-load.yml",
    "test:perf": "npm run test:perf:k6:api",
    "test:lighthouse": "lhci autorun --config=tests/performance/lighthouse/home.config.json",
    "test:inventory:e2e": "npm run test --workspace=apps/api-gateway -- --testPathPattern=inventory-e2e",
    "test:inventory:concurrent": "npm run test --workspace=apps/api-gateway -- --testPathPattern=inventory-concurrent",
    "test:promotions:e2e": "npm run test --workspace=apps/api-gateway -- --testPathPattern=promotions-e2e",
    "test:partner:e2e": "npm run test --workspace=apps/api-gateway -- --testPathPattern=partner-onboarding-e2e",
    "test:rider:e2e": "npm run test --workspace=apps/api-gateway -- --testPathPattern=rider-tracking-e2e"
  },
  "devDependencies": {
    "react-native-dotenv": "^3.4.11",
    "turbo": "^2.9.6"
  },
  "dependencies": {
    "playwright": "^1.61.1"
  }
}
