# Template for the local demo stack env (copy to .env.demo, which is gitignored).
# NEVER commit a real .env.demo or real credentials. Fill in your own values;
# the demo logins below are placeholders, not working accounts.

# Database — matches the local Postgres installed by the cold-restore runbook
# (bound to loopback only; see AGENTS.md "Restoring the local stack from cold").
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/aagam_local?schema=public
# Production-like default that used to live in .env.demo:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aagam_ecom?schema=public

# Auth
JWT_SECRET=replace-with-openssl-rand-hex-32
PORT=3005

# Redis (the gateway refuses to boot without it)
REDIS_URL=redis://localhost:6379

# Demo role logins (placeholder addresses/passwords — provision your own)
AAGAM_CUSTOMER_EMAIL=demo-customer@example.test
AAGAM_CUSTOMER_PASSWORD=change-me
AAGAM_STORE_EMAIL=demo-store@example.test
AAGAM_STORE_PASSWORD=change-me
AAGAM_ADMIN_EMAIL=demo-admin@example.test
AAGAM_ADMIN_PASSWORD=change-me

# Rider token used by the local preview harness (mint from the LOCAL gateway,
# never from production). Leave blank and export at run time if you prefer.
AAGAM_RIDER_TOKEN=
