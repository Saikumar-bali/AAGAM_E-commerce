# ================================================
# AAGAM E-Commerce Environment Variables
# ================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ================================================
# REQUIRED - Security
# ================================================

# JWT Secret - Generate a strong random string (min 32 chars)
# Example: openssl rand -hex 32
JWT_SECRET=change-this-to-a-strong-random-string-min-32-chars

# ================================================
# REQUIRED - Database
# ================================================

# PostgreSQL connection string (add ?sslmode=require for production)
DATABASE_URL=postgresql://user:password@localhost:5432/aagam_ecom?schema=public
# For production: postgresql://user:password@host:5432/aagam?sslmode=require

# ================================================
# OPTIONAL - Supabase (for later production)
# ================================================

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# ================================================
# OPTIONAL - Redis (auto-fallback if not available)
# ================================================

# REDIS_URL=redis://localhost:6379

# ================================================
# OPTIONAL - Environment & CORS
# ================================================

# NODE_ENV=development
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ================================================
# OPTIONAL - Google Sign-In
# ================================================

# OAuth 2.0 Web client ID (used by web login and mobile SDK to mint ID token)
# NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID is required on the web app deployment environment.
GOOGLE_WEB_CLIENT_ID=

# OAuth 2.0 Android client ID (audience accepted by backend token verifier)
GOOGLE_ANDROID_CLIENT_ID=

# Optional: required only if implementing Google auth code exchange on server
# GOOGLE_CLIENT_SECRET=

# ================================================
# PHASE 1 - Firebase Web Push
# ================================================

# Server credential. Prefer the single-line JSON environment variable in
# hosted environments. A local firebase-adminsdk.json file is also supported
# but must never be committed.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase web application configuration returned by the API to authenticated
# clients. These values are not service-account secrets.
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_PROJECT_ID=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
FIREBASE_WEB_VAPID_KEY=

# The Next.js service-worker route can use the same server-side values above.
# NEXT_PUBLIC equivalents are optional when both apps share one environment.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Notification worker defaults to 10 seconds and is disabled automatically in
# NODE_ENV=test.
# NOTIFICATION_WORKER_INTERVAL_MS=10000
# NOTIFICATION_WORKER_DISABLED=false

# ================================================
# PRODUCTION VALUES (do not use in development)
# ================================================
# NODE_ENV=production
# CORS_ORIGINS=https://yourdomain.com
# PORT=3000
