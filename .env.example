# ================================================
# AAGAM E-Commerce Environment Variables
# ================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ================================================
# REQUIRED - Security
# ================================================

# JWT Secret - Generate a strong random string (min 32 chars)
# Example: openssl rand -hex 32
JWT_SECRET=change-this-to-a-strong-random-string-min-32-chars

# ================================================
# REQUIRED - Database
# ================================================

# PostgreSQL connection string (add ?sslmode=require for production)
DATABASE_URL=postgresql://user:password@localhost:5432/aagam_ecom?schema=public
# For production: postgresql://user:password@host:5432/aagam?sslmode=require

# ================================================
# REQUIRED in Production - Redis
# ================================================

REDIS_URL=redis://localhost:6379

# ================================================
# REQUIRED in Production - CORS
# ================================================

# Comma-separated allowed origins (required in production)
# Example: https://admin.aagam.com,https://aagam.com
CORS_ORIGINS=

# ================================================
# OPTIONAL - Environment & Server
# ================================================

# NODE_ENV=development
# PORT=3005

# ================================================
# OPTIONAL - WhatsApp Cloud API phone OTP
# ================================================
# SMS_ONLY makes WhatsApp the direct phone OTP provider.
# PARTNER_PHONE_VERIFICATION_MODE=SMS_ONLY
# PARTNER_SMS_PROVIDER=WHATSAPP
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_GRAPH_API_VERSION=vXX.X
# WHATSAPP_OTP_TEMPLATE_NAME=authentication_code_copy_code_button
# WHATSAPP_OTP_TEMPLATE_LANGUAGE_CODE=en_US
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# Public production callback: https://aagaam.in/api/whatsapp/webhook

# ================================================
# OPTIONAL - Twilio SMS alternative
# ================================================
# PARTNER_SMS_PROVIDER=TWILIO
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_PHONE=

# ================================================
# OPTIONAL - Google Sign-In
# ================================================

GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ================================================
# OPTIONAL - Supabase (for later production)
# ================================================

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# ================================================
# TESTING ONLY - Playwright QA
# ================================================
# NEVER set these in production. They are used for local Playwright testing only.
# PLAYWRIGHT_QA=true
# PLAYWRIGHT_QA_SEED=true

# ================================================
# PRODUCTION VALUES (do not use in development)
# ================================================
# NODE_ENV=production
# CORS_ORIGINS=https://yourdomain.com
# PORT=3000
# DATABASE_URL=postgresql://user:password@host:5432/aagam?sslmode=require
# REDIS_URL=redis://your-redis-host:6379
