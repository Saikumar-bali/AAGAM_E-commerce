# ================================================
# AAGAM E-Commerce Environment Variables
# ================================================
# Copy this file to .env and fill in the values
# NEVER commit .env to version control!

# ================================================
# REQUIRED - Security
# ================================================

# JWT Secret - Generate a strong random string (min 32 chars)
# Example: openssl rand -hex 32
JWT_SECRET=change-this-to-a-strong-random-string-min-32-chars

# ================================================
# REQUIRED - Database
# ================================================

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/aagam_ecom

# ================================================
# OPTIONAL - Supabase (for later production)
# ================================================

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-supabase-anon-key

# ================================================
# OPTIONAL - Redis (auto-fallback if not available)
# ================================================

# REDIS_URL=redis://localhost:6379

# ================================================
# OPTIONAL - Environment & CORS
# ================================================

# NODE_ENV=development
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ================================================
# PRODUCTION VALUES (do not use in development)
# ================================================
# NODE_ENV=production
# CORS_ORIGINS=https://yourdomain.com
# PORT=3000