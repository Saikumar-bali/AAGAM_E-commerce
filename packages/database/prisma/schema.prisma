model SubscriptionPlan {
  id                         String                         @id @default(cuid())
  code                       String                         @unique
  internalName               String
  name                       String
  description                String?
  imageUrl                   String?
  mobileImageUrl             String?
  status                     SubscriptionPlanStatus         @default(DRAFT)
  fundingCycle               SubscriptionFundingCycle
  durationDays               Int
  totalDeliveries            Int
  deliveryFrequency          SubscriptionDeliveryFrequency
  selectedWeekdays           Int[]                          @default([])
  customSchedule             Json?
  pricePaise                 Int
  mrpPaise                   Int
  currency                   String                         @default("INR")
  defaultWindowStartMinute   Int
  defaultWindowEndMinute     Int
  orderGenerationHoursBefore Int                            @default(18)
  skipCutoffHours            Int                            @default(12)
  allowPause                 Boolean                        @default(true)
  allowSkip                  Boolean                        @default(true)
  maximumSkips               Int                            @default(3)
  skipPolicy                 SubscriptionSkipPolicy         @default(EXTEND_PLAN)
  allowTrustedDrop           Boolean                        @default(true)
  allowPersonalHandover      Boolean                        @default(true)
  allowSecurityHandover      Boolean                        @default(true)
  proofPolicy                Json
  isAutoRenewEnabled         Boolean                        @default(false)
  startsAt                   DateTime?
  endsAt                     DateTime?
  sortOrder                  Int                            @default(0)
  createdById                String
  updatedById                String
  createdBy                  User                           @relation("SubscriptionPlanCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy                  User                           @relation("SubscriptionPlanUpdatedBy", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt                  DateTime                       @default(now())
  updatedAt                  DateTime                       @updatedAt

  items         SubscriptionPlanItem[]
  versions      SubscriptionPlanVersion[]
  stores        SubscriptionPlanStore[]
  zones         SubscriptionPlanZone[]
  subscriptions CustomerSubscription[]

  @@index([status, sortOrder])
  @@index([startsAt, endsAt])
}

model SubscriptionPlanItem {
  id                  String           @id @default(cuid())
  planId              String
  productId           String
  quantityPerDelivery Int
  substituteRules     Json?
