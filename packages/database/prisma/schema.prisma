  outboxEvent   OutboxEvent?          @relation("OutboxNotification", fields: [outboxEventId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())

  recipients NotificationRecipient[]

  @@index([eventType, createdAt])
  @@index([orderId, createdAt])
  @@index([deliveryJobId, createdAt])
}

model NotificationRecipient {
  id             String                      @id @default(cuid())
  notificationId String
  notification   Notification                @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientRole  Role?
  status         NotificationRecipientStatus @default(QUEUED)
  dedupeKey      String                      @unique
  sentAt         DateTime?
  openedAt       DateTime?
  readAt         DateTime?
  failedAt       DateTime?
  failureReason  String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  attempts NotificationDeliveryAttempt[]

  @@unique([notificationId, userId, recipientRole])
  @@index([userId, status, createdAt])
  @@index([userId, recipientRole, status, createdAt])
}

model NotificationDeliveryAttempt {
  id             String                    @id @default(cuid())
  recipientId    String
  recipient      NotificationRecipient     @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  subscriptionId String?
  subscription   PushSubscription?         @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  attemptNumber  Int                       @default(1)
  status         NotificationAttemptStatus @default(PENDING)
  provider       PushProvider
  responseId     String?
  errorCode      String?
  errorMessage   String?
  nextRetryAt    DateTime?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@unique([recipientId, subscriptionId, attemptNumber])
  @@index([recipientId, createdAt])
  @@index([status, nextRetryAt])
}

