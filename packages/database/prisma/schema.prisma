generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String?
  googleSub           String?
  phone               String?   @unique
  name                String?
  avatarUrl           String?
  emailVerified       Boolean   @default(false)
  role                Role      @default(CUSTOMER)
  isActive            Boolean   @default(true)
  deactivatedAt       DateTime?
  deactivationReason  String?
  fcmToken            String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  riderProfile            RiderProfile?
  orders                  Order[]
  addresses               CustomerAddress[]
  stores                  Store[]                  @relation("StoreOwner")
  pushSubscriptions       PushSubscription[]
  notificationRecipients  NotificationRecipient[]
  notificationPreferences NotificationPreference[]
  promotionCampaigns    PromotionCampaign[]
  createdCoupons        Coupon[]
  couponRedemptions     CouponRedemption[]
  customerSubscriptions CustomerSubscription[] @relation("CustomerSubscriptions")
  subscriptionPlansCreated SubscriptionPlan[] @relation("SubscriptionPlanCreatedBy")
  subscriptionPlansUpdated SubscriptionPlan[] @relation("SubscriptionPlanUpdatedBy")
  subscriptionVersionsCreated SubscriptionPlanVersion[] @relation("SubscriptionPlanVersionCreatedBy")
  subscriptionCancellations CustomerSubscription[] @relation("SubscriptionCancelledBy")
  subscriptionAudits SubscriptionAuditEntry[] @relation("SubscriptionAuditActor")
  subscriptionIssues SubscriptionIssueReport[] @relation("SubscriptionIssueCustomer")
  subscriptionIssuesResolved SubscriptionIssueReport[] @relation("SubscriptionIssueResolver")
  cashDepositBatchesSubmitted CashDepositBatch[] @relation("CashDepositSubmittedBy")
  cashDepositBatchesVerified CashDepositBatch[] @relation("CashDepositVerifiedBy")
  cashDepositAudits CashDepositAuditEntry[] @relation("CashDepositAuditActor")
  deliveryRunAudits DeliveryRunAuditEntry[]
  deliveryRouteEvents DeliveryRouteEvent[]
  trustedDropCredentials TrustedDropCredential[] @relation("TrustedDropCredentialCustomer")
  trustedDropChallenges TrustedDropChallenge[] @relation("TrustedDropChallengeCustomer")
}

enum Role {
  CUSTOMER
  RIDER
  ADMIN
  STORE_OWNER
}

model Store {
  id        String    @id @default(cuid())
  name      String
  address   String
  latitude  Float
  longitude Float
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  ownerId   String
  owner     User      @relation("StoreOwner", fields: [ownerId], references: [id])
  operatingHours Json?
  timezone   String   @default("Asia/Kolkata")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  inventory        Inventory[]
  orders           Order[]
  inventoryLedgers InventoryLedger[]
  coupons              Coupon[]
  subscriptionPlanLinks SubscriptionPlanStore[]
  customerSubscriptions CustomerSubscription[]
  subscriptionDeliveries SubscriptionDelivery[]
  deliveryRuns DeliveryRun[]
  cashDepositBatches CashDepositBatch[]
  deliveryZoneLinks DeliveryZoneStore[]
  deliveryFeeRules DeliveryFeeRule[]
}

enum DeliveryFeeMatchType {
  PINCODE
  CITY
  KEYWORD
  DEFAULT
}

model DeliveryFeeRule {
  id              String               @id @default(cuid())
  name            String
  matchType       DeliveryFeeMatchType
  pincode         String?
  city            String?
  keywords        String[]
  storeId         String?
  store           Store?               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  ratePaisePerKm  Int                  @default(200)
  flatFeePaise    Int?
  freeDeliveryMinimumPaise Int?
  maximumDistanceKm Float?
  priority        Int                  @default(100)
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([storeId])
  @@index([matchType])
}

model ServiceableLocality {
  id        String  @id @default(cuid())
  name      String
  aliases   String[] @default([])
  city      String
  state     String  @default("ANDHRA PRADESH")
  pincode   String
  latitude  Float?
  longitude Float?
  zoneId    String?
  zone      DeliveryZone? @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customerAddresses CustomerAddress[] @relation("CustomerAddressLocality")

  @@unique([pincode, name])
  @@index([pincode])
  @@index([city])
  @@index([zoneId])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  imageUrl String?
  sortOrder Int      @default(0)
  products Product[]
  promotionCampaigns  PromotionCampaign[]
  couponEligibilities CouponCategoryEligibility[]
}

model Product {
  id          String    @id @default(cuid())
  name        String
  description String?
  price       Float
  pricePaise  Int       @default(0)
  mrpPaise    Int       @default(0)
  image       String?
  images      Json?
  details     Json?
  weightGrams Int?
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  deletedAt   DateTime?
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  inventory        Inventory[]
  orderItems       OrderItem[]
  inventoryLedgers InventoryLedger[]
  promotionCampaigns  PromotionCampaign[]
  couponEligibilities CouponProductEligibility[]
  subscriptionPlanItems SubscriptionPlanItem[]
}

model DeliveryZone {
  id                               String   @id @default(cuid())
  name                             String   @unique
  code                             String   @unique
  description                      String?
  timezone                         String   @default("Asia/Kolkata")
  isActive                         Boolean  @default(true)
  sortOrder                        Int      @default(0)
  priority                         Int      @default(0)
  polygon                          Json?
  centerLatitude                   Float?
  centerLongitude                  Float?
  fallbackRadiusKm                 Float?
  deliverySlots                    Json?
  maximumDailySubscriptionCapacity Int      @default(200)
  maximumStopsPerRun               Int      @default(15)
  maximumRouteDistanceKm           Float    @default(30)
  maximumEstimatedDurationMinutes  Int      @default(120)
  maximumParcelCount               Int      @default(50)
  maximumWeightKg                  Float?
  cashRiskLimitPaise               Int      @default(1000000)
  slotEndBufferMinutes             Int      @default(15)
  allowedVehicleTypes              String[] @default([])
  neighbouringZoneIds              String[] @default([])
  createdAt                        DateTime @default(now())
  updatedAt                        DateTime @updatedAt

  subscriptionPlanLinks SubscriptionPlanZone[]
  storeLinks            DeliveryZoneStore[]
  preferredRiderLinks   DeliveryZonePreferredRider[]
  customerAddresses     CustomerAddress[]
  customerSubscriptions CustomerSubscription[]
  subscriptionDeliveries SubscriptionDelivery[]
  orders                Order[]
  deliveryRuns          DeliveryRun[]
  deliveryRunStops      DeliveryRunStop[]
  homeRiders            RiderProfile[]
  localities            ServiceableLocality[]

  @@index([isActive, priority, sortOrder])
}

model Inventory {
  id        String   @id @default(cuid())
  storeId   String
  productId String
  quantity  Int      @default(0)
  isListed  Boolean  @default(true)
  autoHideWhenOutOfStock Boolean @default(true)
  sellingPricePaise Int?
  store     Store    @relation(fields: [storeId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  updatedAt DateTime @updatedAt

  @@unique([storeId, productId])
  @@index([storeId, isListed, quantity])
}

model Order {
  id               String        @id @default(cuid())
  customerId       String
  customer         User          @relation(fields: [customerId], references: [id])
  storeId          String
  store            Store         @relation(fields: [storeId], references: [id])
  status           OrderStatus   @default(PENDING)
  totalAmount      Float
  currency         String        @default("INR")
  subtotal         Float         @default(0)
  deliveryFee      Float         @default(0)
  discountAmount   Float         @default(0)
  taxAmount        Float         @default(0)
  grandTotal       Float         @default(0)
  subtotalPaise    Int           @default(0)
  deliveryFeePaise Int           @default(0)
  discountPaise    Int           @default(0)
  taxPaise         Int           @default(0)
  grandTotalPaise  Int           @default(0)
  deliveryLat      Float?
  deliveryLng      Float?
  deliveryZoneId   String?
  deliveryZoneSnapshot Json?
  idempotencyKey   String?       @unique
  orderSource      OrderSource   @default(CHECKOUT)
  subscriptionId  String?
  subscriptionDeliveryId String? @unique
  scheduledDeliveryDate DateTime?
  deliveryWindowStart DateTime?
  deliveryWindowEnd DateTime?
  subscriptionSequence Int?
  customerSnapshot Json?
  addressSnapshot  Json?
  itemsSnapshot    Json?
  pricingSnapshot  Json?
  riderId          String?
  rider            RiderProfile? @relation(fields: [riderId], references: [id])
  confirmedAt      DateTime?
  pickingAt        DateTime?
  packedAt         DateTime?
  riderAssignedAt  DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  paymentFailedAt  DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items              OrderItem[]
  payment            Payment?
  refunds            Refund[]
  statusHistory      OrderStatusHistory[]
  riderLocationPings RiderLocationPing[]
  deliveryJob        DeliveryJob?
  pickupProof        PickupProof?
  deliveryProof      DeliveryProof?
  codLedger          CodLedger?
  failureDecisions   DeliveryFailureDecision[]
  notifications      Notification[]
  couponRedemption   CouponRedemption?
  subscription CustomerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionDelivery SubscriptionDelivery? @relation("OrderSubscriptionDelivery", fields: [subscriptionDeliveryId], references: [id], onDelete: SetNull)
  deliveryZone DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  @@index([orderSource, scheduledDeliveryDate])
  @@index([deliveryZoneId, scheduledDeliveryDate])
  @@index([subscriptionId, scheduledDeliveryDate])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int
  price          Float
  unitPricePaise Int     @default(0)
  lineTotalPaise Int     @default(0)
  order          Order   @relation(fields: [orderId], references: [id])
  product        Product @relation(fields: [productId], references: [id])
}

model RiderProfile {
  id                       String                      @id @default(cuid())
  userId                   String                      @unique
  user                     User                        @relation(fields: [userId], references: [id])
  status                   RiderStatus                 @default(OFFLINE)
  latitude                 Float?
  longitude                Float?
  homeZoneId               String?
  maximumParcelCapacity    Int                         @default(15)
  maximumCashHoldingPaise  Int                         @default(1000000)
  orders                   Order[]
  locationPings            RiderLocationPing[]
  availabilityLocation     RiderAvailabilityLocation?
  deliveryJobs             DeliveryJob[]               @relation("DeliveryJobCurrentRider")
  dispatchAssignments      DispatchAssignment[]
  vehicleType              String?
  vehicleNumber            String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  bankAccountCiphertext    String?
  bankIfscCiphertext       String?
  bankAccountLast4         String?
  bankStatus               RiderApprovalStatus         @default(PENDING)
  approvalStatus           RiderApprovalStatus         @default(PENDING)
  bankReviewedByUserId     String?
  bankReviewedAt           DateTime?
  approvalReviewedByUserId String?
  approvalReviewedAt       DateTime?
  availabilitySchedules    RiderAvailabilitySchedule[]
  shifts                   RiderShift[]
  breaks                   RiderBreak[]
  documents                RiderDocument[]
  earnings                 RiderEarning[]
  pickupTasks              RiderPickupTask[]
  pickupProofs             PickupProof[]
  deliveryProofs           DeliveryProof[]
  codLedgers               CodLedger[]
  supportTickets           RiderSupportTicket[]
  trustedDropEvidence      TrustedDropEvidence[]
  geofenceProofs           RunStopGeofenceProof[]
  deliveryRuns             DeliveryRun[]
  cashDepositBatches       CashDepositBatch[]
  homeZone                  DeliveryZone?               @relation(fields: [homeZoneId], references: [id], onDelete: SetNull)
  preferredZoneLinks        DeliveryZonePreferredRider[]
  updatedAt                DateTime                    @updatedAt
}

model RiderAvailabilityLocation {
  riderProfileId String       @id
  riderProfile   RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)
  latitude       Float
  longitude      Float
  capturedAt     DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([capturedAt])
}

enum OrderSource {
  CHECKOUT
  SUBSCRIPTION
  ADMIN
}

enum OrderStatus {
  PENDING
  PAYMENT_PENDING
  PAYMENT_FAILED
  CONFIRMED
  PICKING
  PACKED
  RIDER_ASSIGNED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryJobStatus {
  WAITING_FOR_DISPATCH
  RIDER_ASSIGNED
  RIDER_EN_ROUTE_TO_STORE
  RIDER_AT_STORE
  PICKUP_VERIFIED
  OUT_FOR_DELIVERY
  RIDER_AT_CUSTOMER
  DELIVERED
  DELIVERY_FAILED
  RETURNING_TO_STORE
  RETURNED_TO_STORE
  CANCELLED
}

enum DispatchAssignmentStatus {
  CREATED
  OFFERED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  REASSIGNED
}

enum DeliveryEventType {
  JOB_CREATED
  JOB_STATUS_CHANGED
  ASSIGNMENT_CREATED
  ASSIGNMENT_OFFERED
  ASSIGNMENT_ACCEPTED
  ASSIGNMENT_REJECTED
  ASSIGNMENT_EXPIRED
  ASSIGNMENT_CANCELLED
  ASSIGNMENT_REASSIGNED
  LEGACY_ADAPTER_USED
}

model DeliveryJob {
  id             String            @id @default(cuid())
  orderId        String            @unique
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         DeliveryJobStatus @default(WAITING_FOR_DISPATCH)
  currentRiderId String?
  currentRider   RiderProfile?     @relation("DeliveryJobCurrentRider", fields: [currentRiderId], references: [id], onDelete: SetNull)
  version        Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  assignments      DispatchAssignment[]
  events           DeliveryEvent[]
  pickupChallenges PickupChallenge[]
  pickupProof      PickupProof?
  deliveryProof    DeliveryProof?
  codLedger        CodLedger?
  failureDecisions DeliveryFailureDecision[]
  notifications    Notification[]
  deliveryRunStop  DeliveryRunStop?
  trustedDropEvidence TrustedDropEvidence?
  subscriptionDelivery SubscriptionDelivery?

  @@index([status, createdAt])
  @@index([currentRiderId, status])
}

enum PickupVerificationMethod {
  STORE_PICKUP_PIN
  QR_CODE
  STORE_CONFIRMED_HANDOFF
}

enum PickupChallengeStatus {
  PENDING
  USED
  EXPIRED
  SUPERSEDED
  FAILED
}

enum DeliveryVerificationMethod {
  CUSTOMER_OTP_PIN
  TRUSTED_DROP
  SECURITY_RECEPTION
  RIDER_PHOTO_EVIDENCE
}

enum CodSettlementStatus {
  AWAITING_COLLECTION
  HELD_BY_RIDER
  PARTIALLY_DEPOSITED
  SETTLED
  VARIANCE_REVIEW
}

enum CodLedgerEntryType {
  EXPECTED
  COLLECTED
  DEPOSITED
  VARIANCE_RECORDED
  COMPENSATING_ADJUSTMENT
}

enum DeliveryFailureReasonCode {
  CUSTOMER_UNREACHABLE
  CUSTOMER_REFUSED
  ADDRESS_NOT_FOUND
  WRONG_ADDRESS
  PAYMENT_NOT_AVAILABLE
  VEHICLE_BREAKDOWN
  PACKAGE_DAMAGED
  SAFETY_CONCERN
  OTHER
}

enum DeliveryResolutionAction {
  RETRY_DELIVERY
  REASSIGN_RIDER
  RETURN_TO_STORE
  CANCEL_AND_REFUND
  ESCALATE_TO_ADMIN
}

enum DeliveryResolutionStatus {
  DECIDED
  IN_PROGRESS
  COMPLETED
  SUPERSEDED
}

model PickupChallenge {
  id                  String                   @id @default(cuid())
  deliveryJobId       String
  deliveryJob         DeliveryJob              @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)
  method              PickupVerificationMethod
  codeHash            String
  salt                String
  issuedByStoreUserId String
  parcelCount         Int
  status              PickupChallengeStatus    @default(PENDING)
  attempts            Int                      @default(0)
  expiresAt           DateTime
  usedAt              DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([deliveryJobId, status, expiresAt])
}

model PickupProof {
  id                 String                   @id @default(cuid())
  deliveryJobId      String                   @unique
  deliveryJob        DeliveryJob              @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)
  orderId            String                   @unique
  order              Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId            String
  rider              RiderProfile             @relation(fields: [riderId], references: [id], onDelete: Restrict)
  storeUserId        String
  verifiedAt         DateTime                 @default(now())
  latitude           Float?
  longitude          Float?
  accuracyMetres     Float?
  parcelCount        Int
  verificationMethod PickupVerificationMethod
  challengeId        String?                  @unique
  createdAt          DateTime                 @default(now())

  @@index([riderId, verifiedAt])
  @@index([storeUserId, verifiedAt])
}

model DeliveryProof {
  id                 String                     @id @default(cuid())
  deliveryJobId      String                     @unique
  deliveryJob        DeliveryJob                @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)
  orderId            String                     @unique
  order              Order                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId            String
  rider              RiderProfile               @relation(fields: [riderId], references: [id], onDelete: Restrict)
  customerUserId     String
  verificationMethod DeliveryVerificationMethod @default(CUSTOMER_OTP_PIN)
  otpOperationId     String?
  proofReference     String?
  riderConfirmedAt   DateTime
  verifiedAt         DateTime                   @default(now())
  note               String?
  latitude           Float?
  longitude          Float?
  accuracyMetres     Float?
  createdAt          DateTime                   @default(now())

  @@index([riderId, verifiedAt])
  @@index([customerUserId, verifiedAt])
}

model CodLedger {
  id                       String              @id @default(cuid())
  deliveryJobId            String              @unique
  deliveryJob              DeliveryJob         @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)
  orderId                  String              @unique
  order                    Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId                  String?
  rider                    RiderProfile?       @relation(fields: [riderId], references: [id], onDelete: Restrict)
  currency                 String              @default("INR")
  expectedAmountPaise      Int
  collectedAmountPaise     Int                 @default(0)
  collectionTimestamp      DateTime?
  riderHoldingBalancePaise Int                 @default(0)
  depositedAmountPaise     Int                 @default(0)
  settlementReference      String?
  variancePaise            Int                 @default(0)
  varianceReason           String?
  status                   CodSettlementStatus @default(AWAITING_COLLECTION)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  entries                  CodLedgerEntry[]
  subscriptionFundingAllocation SubscriptionFundingAllocation?
  cashDepositBatchEntry CashDepositBatchEntry?

  @@index([riderId, status])
  @@index([status, updatedAt])
}

model CodLedgerEntry {
  id                  String             @id @default(cuid())
  codLedgerId         String
  codLedger           CodLedger          @relation(fields: [codLedgerId], references: [id], onDelete: Cascade)
  type                CodLedgerEntryType
  amountPaise         Int
  holdingAfterPaise   Int
  depositedAfterPaise Int
  actorUserId         String
  actorRole           Role
  reference           String?
  idempotencyKey      String             @unique
  metadata            Json?
  createdAt           DateTime           @default(now())

  @@index([codLedgerId, createdAt])
  @@index([actorUserId, createdAt])
}

model DeliveryFailureDecision {
  id                 String                    @id @default(cuid())
  deliveryJobId      String
  deliveryJob        DeliveryJob               @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)
  orderId            String
  order              Order                     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  failureOperationId String                    @unique
  reason             DeliveryFailureReasonCode
  recommendedAction  DeliveryResolutionAction
  decidedAction      DeliveryResolutionAction
  status             DeliveryResolutionStatus  @default(DECIDED)
  policyVersion      String
  rationale          String
  decidedBy          String                    @default("SYSTEM")
  overriddenByUserId String?
  overrideReason     String?
  appliedByUserId    String?
  appliedAt          DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  @@index([deliveryJobId, createdAt])
  @@index([status, recommendedAction, createdAt])
}

model DispatchAssignment {
  id              String                   @id @default(cuid())
  deliveryJobId   String
  deliveryJob     DeliveryJob              @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)
  riderProfileId  String
  riderProfile    RiderProfile             @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)
  status          DispatchAssignmentStatus @default(CREATED)
  offeredAt       DateTime?
  respondedAt     DateTime?
  expiresAt       DateTime?
  rejectionReason String?
  createdByUserId String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  events DeliveryEvent[]

  @@index([deliveryJobId, status])
  @@index([riderProfileId, status])
  @@index([expiresAt, status])
}

model DeliveryEvent {
  id            String              @id @default(cuid())
  deliveryJobId String
  deliveryJob   DeliveryJob         @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)
  assignmentId  String?
  assignment    DispatchAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  eventType     DeliveryEventType
  fromStatus    DeliveryJobStatus?
  toStatus      DeliveryJobStatus?
  actorUserId   String?
  actorRole     Role?
  metadata      Json?
  createdAt     DateTime            @default(now())

  @@index([deliveryJobId, createdAt])
  @@index([assignmentId, createdAt])
  @@index([eventType, createdAt])
}

model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?
  actorRole   Role?
  note        String?
  metadata    Json?
  createdAt   DateTime     @default(now())

  @@index([orderId, createdAt])
}

model RiderLocationPing {
  id             String       @id @default(cuid())
  riderProfileId String
  riderProfile   RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  latitude       Float
  longitude      Float
  accuracy       Float?
  speed          Float?
  heading        Float?
  source         String       @default("MOBILE")
  createdAt      DateTime     @default(now())

  @@index([orderId, createdAt])
  @@index([riderProfileId, createdAt])
}

model CustomerAddress {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  label              String?
  recipientName      String
  phoneE164          String
  alternatePhoneE164 String?
  line1              String
  line2              String?
  landmark           String?
  city               String
  state              String
  pincode            String
  country            String   @default("IN")
  latitude           Float
  longitude          Float
  instructions       String?
  isDefault          Boolean  @default(false)
  deliveryZoneId     String?
  zoneResolvedAt     DateTime?
  zoneResolutionSource DeliveryZoneResolutionSource?
  zoneResolutionConfidence Float?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  subscriptions      CustomerSubscription[]
  deliveryZone       DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  localityId         String?
  locality           ServiceableLocality? @relation("CustomerAddressLocality", fields: [localityId], references: [id], onDelete: SetNull)

  @@index([deliveryZoneId])
  @@index([localityId])
}

enum PaymentMethod {
  ONLINE
  COD
  SUBSCRIPTION_CASH_CREDIT
}

enum PaymentStatus {
  CREATED
  CAPTURED
  FAILED
  PENDING_COD
  SUBSCRIPTION_FUNDED
  REFUND_PENDING
  REFUNDED
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id])
  method            PaymentMethod
  status            PaymentStatus @default(CREATED)
  provider          String        @default("SIMULATED")
  amount            Float
  amountPaise       Int           @default(0)
  currency          String        @default("INR")
  idempotencyKey    String?       @unique
  providerOrderId   String?
  providerPaymentId String?
  verifiedAt        DateTime?
  failureReason     String?
  refunds           Refund[]
