  cancelledById              String?
  customer                   User                       @relation("CustomerSubscriptions", fields: [customerId], references: [id], onDelete: Restrict)
  plan                       SubscriptionPlan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  planVersion                SubscriptionPlanVersion    @relation(fields: [planVersionId], references: [id], onDelete: Restrict)
  address                    CustomerAddress            @relation(fields: [addressId], references: [id], onDelete: Restrict)
  homeStore                  Store?                     @relation(fields: [homeStoreId], references: [id], onDelete: SetNull)
  deliveryZone               DeliveryZone?              @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  cancelledBy                User?                      @relation("SubscriptionCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  deliveries        SubscriptionDelivery[]
  orders            Order[]
  fundingAllocations SubscriptionFundingAllocation[]
  issues            SubscriptionIssueReport[]
  audits            SubscriptionAuditEntry[]
  trustedDropCredential TrustedDropCredential?
  trustedDropChallenges TrustedDropChallenge[]

  @@index([customerId, status])
  @@index([status, nextDeliveryDate])
  @@index([homeStoreId, status])
  @@index([deliveryZoneId, status])
}

model SubscriptionDelivery {
  id                     String                     @id @default(cuid())
  subscriptionId         String
  serviceDate            DateTime
  sequenceNumber         Int
  status                 SubscriptionDeliveryStatus @default(SCHEDULED)
  generationKey          String                     @unique
  deliveryJobId          String?                    @unique
  storeId                String?
  deliveryZoneId         String?
  cashDuePaise           Int                        @default(0)
  proofMode              SubscriptionProofMode
  failureReason          String?
  deferredReason         String?
  generationAttempts     Int                        @default(0)
  lastGenerationAttemptAt DateTime?
  lastAttemptCorrelationId String?
  skipReason             String?
  rescheduledFromDate    DateTime?
  rescheduledToDate      DateTime?
  generatedAt            DateTime?
  deliveredAt            DateTime?
  skippedAt              DateTime?
  failedAt               DateTime?
  subscription           CustomerSubscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  order                  Order?                     @relation("OrderSubscriptionDelivery")
  deliveryJob            DeliveryJob?               @relation(fields: [deliveryJobId], references: [id], onDelete: SetNull)
  store                  Store?                     @relation(fields: [storeId], references: [id], onDelete: SetNull)
  deliveryZone           DeliveryZone?              @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  runStop                DeliveryRunStop?
  issueReports           SubscriptionIssueReport[]
  generationAttemptRows  SubscriptionGenerationAttempt[]
  trustedDropChallenges  TrustedDropChallenge[]
  trustedDropEvidence    TrustedDropEvidence?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([subscriptionId, serviceDate])
  @@unique([subscriptionId, sequenceNumber])
  @@index([status, serviceDate])
  @@index([storeId, serviceDate])
  @@index([deliveryZoneId, serviceDate, status])
}

model SubscriptionFundingAllocation {
  id                    String                              @id @default(cuid())
  subscriptionId        String
  codLedgerId           String                              @unique
  startsAtSequence      Int
  endsAtSequence        Int
  fundedDeliveryCount   Int
  amountPaise           Int
  status                SubscriptionFundingAllocationStatus @default(ALLOCATED)
  idempotencyKey        String                              @unique
  subscription          CustomerSubscription                @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  codLedger             CodLedger                           @relation(fields: [codLedgerId], references: [id], onDelete: Restrict)
  createdAt             DateTime                            @default(now())
  reversedAt            DateTime?
  reversalReason        String?

  @@index([subscriptionId, status])
}

model DeliveryRun {
  id                       String                @id @default(cuid())
  routeCode                String                @unique
  storeId                  String
  riderId                  String?
  deliveryZoneId           String?
  serviceDate              DateTime
  slotStart                DateTime
  slotEnd                  DateTime
  deliveryCluster          String
  status                   DeliveryRunStatus     @default(PLANNED)
  totalStopCount           Int                   @default(0)
  completedStopCount       Int                   @default(0)
  failedStopCount          Int                   @default(0)
  retryPendingStopCount    Int                   @default(0)
  expectedCashPaise        Int                   @default(0)
  collectedCashPaise       Int                   @default(0)
  depositedCashPaise       Int                   @default(0)
  varianceCashPaise        Int                   @default(0)
  expectedParcelCount      Int                   @default(0)
  expectedWeightGrams      Int                   @default(0)
  expectedItemCount        Int                   @default(0)
  expectedBagCount         Int                   @default(0)
  packedBagCount           Int                   @default(0)
  crateCode                String?               @unique
  packingConfirmedAt       DateTime?
  packingConfirmedById     String?
  storeHandoffConfirmedAt  DateTime?
  storeHandoffConfirmedById String?
  pickupConfirmedAt        DateTime?
  pickupConfirmedById      String?
  startedAt                DateTime?
  completedAt              DateTime?
  planningAlgorithmVersion String                @default("regional-nearest-neighbour-v1")
  plannedAt                DateTime?
  originalStopCount        Int                   @default(0)
  estimatedDistanceKm      Float                 @default(0)
  estimatedDurationMinutes Int                   @default(0)
  clusterIdentifier        String?
  manualOverride           Boolean               @default(false)
  manualOverrideReason     String?
  assignmentScoreVersion   String?
  assignmentReasonSummary String?
  assignmentConstraints    Json?
  assignmentSource         RouteAssignmentSource?
  recoveryFromRunId        String?
  interruptedAt            DateTime?
  interruptionReason       String?
  version                  Int                   @default(0)
  store                    Store                 @relation(fields: [storeId], references: [id], onDelete: Restrict)
  rider                    RiderProfile?         @relation(fields: [riderId], references: [id], onDelete: SetNull)
  deliveryZone             DeliveryZone?         @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  recoveryFromRun          DeliveryRun?          @relation("RecoveryRuns", fields: [recoveryFromRunId], references: [id], onDelete: SetNull)
  recoveryRuns             DeliveryRun[]         @relation("RecoveryRuns")
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  stops                   DeliveryRunStop[]
  movedStops              DeliveryRunStop[]      @relation("MovedFromRun")
  depositBatch            CashDepositBatch?
  audits                  DeliveryRunAuditEntry[] @relation("DeliveryRunAudits")
  auditSourceEntries      DeliveryRunAuditEntry[] @relation("DeliveryRunAuditSource")
  auditDestinationEntries DeliveryRunAuditEntry[] @relation("DeliveryRunAuditDestination")
  routeEvents             DeliveryRouteEvent[]

  @@unique([storeId, serviceDate, slotStart, deliveryCluster])
  @@index([riderId, serviceDate, status])
  @@index([storeId, serviceDate, status])
  @@index([deliveryZoneId, serviceDate, status])
  @@index([clusterIdentifier, serviceDate])
}

model DeliveryRunStop {
  id                     String                @id @default(cuid())
  deliveryRunId          String
  deliveryJobId          String                @unique
  subscriptionDeliveryId String                @unique
  deliveryZoneId         String?
  sequenceNumber         Int
  status                 DeliveryRunStopStatus @default(PLANNED)
  proofMode              SubscriptionProofMode
  cashDuePaise           Int                   @default(0)
  expectedItemCount      Int
  expectedWeightGrams    Int                   @default(0)
  expectedParcelCount    Int                   @default(1)
  deliveryLatitude       Float?
  deliveryLongitude      Float?
  arrivedAt              DateTime?
  deliveredAt            DateTime?
  failedAt               DateTime?
  retryCount             Int                   @default(0)
  latitude               Float?
  longitude              Float?
  accuracyMetres         Float?
  proofReference         String?
  failureReason          String?
  routeOrderChangeReason String?
  movedFromRunId         String?
  lastMovedAt            DateTime?
  version                Int                   @default(0)
  deliveryRun            DeliveryRun           @relation(fields: [deliveryRunId], references: [id], onDelete: Cascade)
  deliveryJob            DeliveryJob           @relation(fields: [deliveryJobId], references: [id], onDelete: Restrict)
  subscriptionDelivery   SubscriptionDelivery  @relation(fields: [subscriptionDeliveryId], references: [id], onDelete: Restrict)
  deliveryZone           DeliveryZone?         @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  movedFromRun           DeliveryRun?          @relation("MovedFromRun", fields: [movedFromRunId], references: [id], onDelete: SetNull)
  routeEvents            DeliveryRouteEvent[]
  geofenceProofs         RunStopGeofenceProof[]
  trustedDropEvidence    TrustedDropEvidence?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  @@unique([deliveryRunId, sequenceNumber])
  @@index([deliveryRunId, status])
  @@index([deliveryZoneId, status])
}

model DeliveryZoneStore {
  zoneId    String
  storeId   String
  priority  Int          @default(0)
  createdAt DateTime     @default(now())
  zone      DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@id([zoneId, storeId])
  @@index([storeId])
}

model DeliveryZonePreferredRider {
  zoneId          String
  riderProfileId  String
  priority        Int          @default(0)
  createdAt       DateTime     @default(now())
  zone            DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  riderProfile    RiderProfile @relation(fields: [riderProfileId], references: [id], onDelete: Cascade)

  @@id([zoneId, riderProfileId])
  @@index([riderProfileId])
}

model DeliveryRunAuditEntry {
  id               String      @id @default(cuid())
  deliveryRunId    String?
  actorUserId      String?
  actorRole        Role?
  action           String
  reason           String
  sourceRunId      String?
  destinationRunId String?
  metadata         Json?
  idempotencyKey   String      @unique
  deliveryRun      DeliveryRun? @relation("DeliveryRunAudits", fields: [deliveryRunId], references: [id], onDelete: SetNull)
  sourceRun        DeliveryRun? @relation("DeliveryRunAuditSource", fields: [sourceRunId], references: [id], onDelete: SetNull)
  destinationRun   DeliveryRun? @relation("DeliveryRunAuditDestination", fields: [destinationRunId], references: [id], onDelete: SetNull)
  actor            User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())

  @@index([deliveryRunId, createdAt])
}

model DeliveryRouteEvent {
  id                String                 @id @default(cuid())
  eventType         DeliveryRouteEventType
  deliveryRunId     String?
  deliveryRunStopId String?
  actorUserId       String?
  payload           Json
  dedupeKey         String                 @unique
  deliveryRun       DeliveryRun?           @relation(fields: [deliveryRunId], references: [id], onDelete: SetNull)
  deliveryRunStop   DeliveryRunStop?       @relation(fields: [deliveryRunStopId], references: [id], onDelete: SetNull)
  actor             User?                  @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt         DateTime               @default(now())

  @@index([deliveryRunId, createdAt])
  @@index([eventType, createdAt])
}

model CashDepositBatch {
  id                    String                 @id @default(cuid())
  reference             String                 @unique
  riderId               String
  storeId               String
  deliveryRunId         String                 @unique
  expectedAmountPaise   Int
  submittedAmountPaise  Int                    @default(0)
  verifiedAmountPaise   Int                    @default(0)
  variancePaise         Int                    @default(0)
  status                CashDepositBatchStatus @default(DRAFT)
  submittedById         String?
  verifiedById          String?
  riderSubmittedAt      DateTime?
  storeVerifiedAt       DateTime?
  settlementReference   String?
  receiptEvidence       Json?
  varianceReason        String?
  version               Int                    @default(0)
  rider                 RiderProfile           @relation(fields: [riderId], references: [id], onDelete: Restrict)
  store                 Store                  @relation(fields: [storeId], references: [id], onDelete: Restrict)
  deliveryRun           DeliveryRun            @relation(fields: [deliveryRunId], references: [id], onDelete: Restrict)
  submittedBy           User?                  @relation("CashDepositSubmittedBy", fields: [submittedById], references: [id], onDelete: SetNull)
  verifiedBy            User?                  @relation("CashDepositVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  entries CashDepositBatchEntry[]
  audits  CashDepositAuditEntry[]

  @@index([riderId, status])
  @@index([storeId, status])
}

model CashDepositBatchEntry {
  id                  String           @id @default(cuid())
  cashDepositBatchId  String
  codLedgerId         String           @unique
  allocatedAmountPaise Int
  holdingBeforePaise  Int
  holdingAfterPaise   Int
  depositedBeforePaise Int
  depositedAfterPaise Int
  cashDepositBatch    CashDepositBatch @relation(fields: [cashDepositBatchId], references: [id], onDelete: Cascade)
  codLedger           CodLedger        @relation(fields: [codLedgerId], references: [id], onDelete: Restrict)
  createdAt           DateTime         @default(now())

  @@index([cashDepositBatchId])
}

model CashDepositAuditEntry {
  id                 String           @id @default(cuid())
  cashDepositBatchId String
  actorUserId        String
  actorRole          Role
  action             String
  amountPaise        Int?
  reason             String?
  metadata           Json?
  idempotencyKey     String           @unique
  cashDepositBatch   CashDepositBatch @relation(fields: [cashDepositBatchId], references: [id], onDelete: Cascade)
  actor              User             @relation("CashDepositAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt          DateTime         @default(now())

  @@index([cashDepositBatchId, createdAt])
}

model SubscriptionIssueReport {
  id                     String                  @id @default(cuid())
  subscriptionId         String
  subscriptionDeliveryId String?
  customerId             String
  type                   SubscriptionIssueType
  status                 SubscriptionIssueStatus @default(OPEN)
  description            String
  evidence               Json?
  idempotencyKey         String                  @unique
  resolvedById           String?
  resolution             String?
  resolvedAt             DateTime?
  subscription           CustomerSubscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionDelivery   SubscriptionDelivery?    @relation(fields: [subscriptionDeliveryId], references: [id], onDelete: SetNull)
  customer               User                    @relation("SubscriptionIssueCustomer", fields: [customerId], references: [id], onDelete: Restrict)
  resolvedBy             User?                   @relation("SubscriptionIssueResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([subscriptionId, status])
  @@index([subscriptionDeliveryId])
  @@index([customerId, createdAt])
}

model SubscriptionAuditEntry {
  id             String               @id @default(cuid())
  subscriptionId String
  actorUserId    String
  actorRole      Role
  action         String
  reason         String?
  metadata       Json?
  idempotencyKey String               @unique
  subscription   CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  actor          User                 @relation("SubscriptionAuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now())

  @@index([subscriptionId, createdAt])
}


enum TrustedDropCredentialStatus {
  ACTIVE
  REVOKED
}

enum GeofencePhase {
  ARRIVAL
  COMPLETION
}

enum GeofenceDecision {
  PASS
  FAIL_DISTANCE
  FAIL_ACCURACY
}

enum SubscriptionGenerationAttemptStatus {
  STARTED
  GENERATED
  DEFERRED
  FAILED
}

model TrustedDropCredential {
  id             String                      @id @default(cuid())
  subscriptionId String                      @unique
  customerId     String
  version        Int                         @default(1)
  status         TrustedDropCredentialStatus @default(ACTIVE)
  createdAt      DateTime                    @default(now())
  rotatedAt      DateTime?
  revokedAt      DateTime?
  subscription   CustomerSubscription        @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  customer       User                        @relation("TrustedDropCredentialCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  challenges     TrustedDropChallenge[]

  @@index([customerId, status])
}

model TrustedDropChallenge {
  id             String                @id @default(cuid())
  credentialId   String
  subscriptionId         String
  subscriptionDeliveryId String?
  customerId             String
  version        Int
  tokenHash      String                @unique
  expiresAt      DateTime
  usedAt         DateTime?
  revokedAt      DateTime?
  createdAt      DateTime              @default(now())
  credential     TrustedDropCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  subscription   CustomerSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  subscriptionDelivery SubscriptionDelivery? @relation(fields: [subscriptionDeliveryId], references: [id], onDelete: Cascade)
  customer       User                  @relation("TrustedDropChallengeCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  evidence       TrustedDropEvidence?

  @@index([subscriptionId, version, expiresAt])
  @@index([subscriptionDeliveryId])
  @@index([customerId, createdAt])
}

model TrustedDropEvidence {
  id                     String               @id @default(cuid())
  deliveryRunStopId      String               @unique
  deliveryJobId          String               @unique
  subscriptionDeliveryId String               @unique
  riderId                String
  challengeId            String               @unique
  credentialVersion      Int
  storageKey             String               @unique
  mimeType               String
  sizeBytes              Int
  sha256                 String
  capturedAt             DateTime
  createdAt              DateTime             @default(now())
  deliveryRunStop        DeliveryRunStop      @relation(fields: [deliveryRunStopId], references: [id], onDelete: Cascade)
  deliveryJob            DeliveryJob          @relation(fields: [deliveryJobId], references: [id], onDelete: Cascade)
  subscriptionDelivery   SubscriptionDelivery @relation(fields: [subscriptionDeliveryId], references: [id], onDelete: Cascade)
  rider                   RiderProfile        @relation(fields: [riderId], references: [id], onDelete: Restrict)
  challenge               TrustedDropChallenge @relation(fields: [challengeId], references: [id], onDelete: Restrict)

  @@index([riderId, capturedAt])
}

model RunStopGeofenceProof {
  id                   String           @id @default(cuid())
  deliveryRunStopId    String
  riderId              String
  phase                 GeofencePhase
  latitude              Float
  longitude             Float
  accuracyMetres        Float
  distanceToStopMetres  Float
  allowedRadiusMetres   Float
  decision              GeofenceDecision
  measuredAt            DateTime
  createdAt             DateTime         @default(now())
  deliveryRunStop       DeliveryRunStop  @relation(fields: [deliveryRunStopId], references: [id], onDelete: Cascade)
  rider                 RiderProfile     @relation(fields: [riderId], references: [id], onDelete: Restrict)

  @@index([deliveryRunStopId, phase, measuredAt])
  @@index([riderId, measuredAt])
}

model SubscriptionGenerationAttempt {
  id                     String                              @id @default(cuid())
  subscriptionDeliveryId String
  attemptNumber          Int
  correlationId          String
  status                 SubscriptionGenerationAttemptStatus
  deferredReason         String?
  message                String?
  metadata               Json?
  startedAt              DateTime                            @default(now())
  finishedAt             DateTime?
  subscriptionDelivery   SubscriptionDelivery                @relation(fields: [subscriptionDeliveryId], references: [id], onDelete: Cascade)

  @@unique([subscriptionDeliveryId, attemptNumber])
  @@index([status, startedAt])
  @@index([correlationId])
}

model SubscriptionWorkerFailure {
  id            String   @id @default(cuid())
  jobId         String   @unique
  correlationId String
  attempts      Int
  lastError     String
  payload       Json?
  failedAt      DateTime @default(now())
  resolvedAt    DateTime?

  @@index([failedAt])
}
